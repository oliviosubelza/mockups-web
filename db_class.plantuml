        total_invoiced_qty : DECIMAL(12,2)
        total_bonus_qty : DECIMAL(12,2)
        total_delivered_qty : DECIMAL(12,2)
        total_returned_qty : DECIMAL(12,2)
        total_shortage_qty : DECIMAL(12,2)
        total_surplus_qty : DECIMAL(12,2)
        total_dispatch_amount : DECIMAL(12,2)
        total_invoiced_amount : DECIMAL(12,2)
        total_bonus_amount : DECIMAL(12,2)
        total_returned_amount : DECIMAL(12,2)
        driver_employee_id : BIGINT | NULL
        driver_signature_svg : TEXT | NULL
        warehouse_responsible_id : BIGINT | NULL
        warehouse_responsible_name : VARCHAR(255) | NULL
        warehouse_signature_svg : TEXT | NULL
        notes : TEXT | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "transport_order_collection_closings" as transport_order_collection_closings <<Liquidación Financiera Caja>> {
        * id : BIGSERIAL <<PK>>
        --
