        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_order_detail_image" as refund_order_detail_image <<Fotos de Evidencia SKU>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_order_detail_id : BIGINT <<FK>>
        url : VARCHAR(255) | NULL
        created_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 10. WORKFLOW DE APROBACIONES (REFUND WORKFLOW ENGINE)
' ==============================================================================
package "10. Motor de Workflow & Aprobaciones (Refund Workflow Engine)" #F2F3F4 {
    entity "refund_workflow_instances" as refund_workflow_instances <<Instancia del Flujo>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_order_id : BIGINT <<FK>>
        attempt : SMALLINT
        status : VARCHAR(20)
        current_level_order : SMALLINT | NULL
        reactivated_from_instance_id : BIGINT <<FK | NULL>>
        started_at : TIMESTAMP
        finished_at : TIMESTAMP | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_workflow_instance_levels" as refund_workflow_instance_levels <<Nivel en Ejecución>> {
        * id : BIGSERIAL <<PK>>
        --
        workflow_instance_id : BIGINT <<FK>>
        level_order : SMALLINT
        level_name : VARCHAR(100)
        role_code : VARCHAR(50)
        min_amount : DECIMAL(12,2)
        max_amount : DECIMAL(12,2)
        decision_mode : VARCHAR(20)
        status : VARCHAR(20)
        first_viewed_at : TIMESTAMP | NULL
        first_viewed_by : VARCHAR(255) | NULL
        started_at : TIMESTAMP | NULL
        finished_at : TIMESTAMP | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_workflow_actions" as refund_workflow_actions <<Historial de Decisiones>> {
        * id : BIGSERIAL <<PK>>
        --
        workflow_instance_id : BIGINT <<FK>>
        workflow_instance_level_id : BIGINT <<FK | NULL>>
        related_refund_order_id : BIGINT <<FK | NULL>>
        action : VARCHAR(30)
        actor_employee_code : BIGINT | NULL
        actor_role_code : VARCHAR(50) | NULL
        system_summary : TEXT
        comment : TEXT
        reason : TEXT
        previous_status : VARCHAR(20) | NULL
        new_status : VARCHAR(20) | NULL
        amount_before : DECIMAL(12,2) | NULL
        amount_after : DECIMAL(12,2) | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_workflow_action_images" as refund_workflow_action_images <<Foto Autorización / Reactivación>> {
        * id : BIGSERIAL <<PK>>
        --
        workflow_action_id : BIGINT <<FK>>
        url : VARCHAR(255)
        created_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_order_detail_decisions" as refund_order_detail_decisions <<Selección Binaria L1>> {
        * id : BIGSERIAL <<PK>>
        --
        workflow_action_id : BIGINT <<FK>>
        refund_order_detail_id : BIGINT <<FK>>
        decision : VARCHAR(20)
        created_at : TIMESTAMP
    }
}

' ==============================================================================
' RELACIONES INTERNAS POR MÓDULO (INTRA-PACKAGE RELATIONSHIPS)
' ==============================================================================

' --- Módulo 02: Territorio & Restricciones ---
planning_restrictions "1" -right-> "0..*" planning_restriction_schedules : vigencias >
planning_restrictions "1" -down-> "0..*" planning_restriction_vehicle_rules : reglas flota >

' --- Módulo 04: Planificación de Despachos ---
plan_status "1" -right-> "0..*" dispatch_plans : clasifica >
dispatch_plans "1" -down-> "0..*" planning_trucks : incluye camión >
dispatch_plans "1" -right-> "1..*" dispatch_delivery_points : consolida paradas >
dispatch_delivery_points "1" -right-> "0..*" image_delivery_points : contiene fotos >
dispatch_delivery_points "0..1" -down-> "0..*" candidate_orders : agrupa pedidos >
planning_trucks "0..1" -right-> "0..*" dispatch_delivery_points : asigna forzado >

' --- Módulo 05: Ruteo & Optimización ---
routes "1" -right-> "1..*" route_delivery_points : secuencia paradas >

' --- Módulo 06: Ejecución de Transporte ---
transport_orders "1" -down-> "0..*" transport_order_histories : registra evento >
transport_orders "1" -right-> "0..*" transport_order_sales : transporta pedidos >
transport_order_sales "1" -right-> "1..*" transport_order_sales_items : contiene ítems >
transport_orders "1" -down-> "0..*" truck_inventories : consolida stock >
transport_orders "1" -down-> "0..*" transport_order_count_sessions : audita conteo >
transport_order_count_sessions "1" -right-> "1..*" transport_order_count_session_items : detalla conteo >
transport_orders "1" -down-> "0..*" transport_order_assets : controla activo >

' --- Módulo 07: Última Milla ---
delivery_orders "1" -right-> "1..*" delivery_order_sales : entrega ventas >
delivery_order_sales "1" -right-> "0..*" delivery_payment_references : liquida cobro >
delivery_order_sales "1" -down-> "1..*" delivery_order_items : descarga ítems >
delivery_orders "1" -down-> "0..1" proof_of_deliveries : respalda entrega >
delivery_orders "1" -down-> "0..*" delivery_incidents : reporta novedad >
delivery_orders "1" -down-> "0..*" delivery_order_histories : traza estado >

' --- Módulo 09: Gestión de Devoluciones ---
refund_reasons "1" -right-> "0..*" refund_reason_params : define reglas >
refund_reason_params "1" -down-> "0..*" refund_reason_param_clients
refund_reason_params "1" -down-> "0..*" refund_reason_param_products
refund_reason_params "1" -down-> "0..*" refund_reason_param_lots
refund_reason_params "1" -down-> "0..*" refund_reason_param_product_groups
refund_reason_params "1" -down-> "0..*" refund_reason_param_sale_channels
refund_reason_params "1" -down-> "0..*" refund_reason_param_distributors

refund_orders "0..1" -down-> "0..*" refund_orders : disocia en >
refund_orders "1" -right-> "1..*" refund_order_details : contiene líneas >
refund_order_details "0..1" -down-> "0..*" refund_order_details : split >
refund_reasons "1" -down-> "0..*" refund_order_details : clasifica motivo >
refund_order_details "1" -right-> "1..*" refund_order_detail_sources : rastrea origen >
refund_order_details "1" -down-> "0..*" refund_order_detail_image : foto daño >

' --- Módulo 10: Workflow Engine ---
refund_workflow_instances "0..1" -down-> "0..*" refund_workflow_instances : reactivada de >
refund_workflow_instances "1" -right-> "1..*" refund_workflow_instance_levels : compone escalera >
refund_workflow_instances "1" -down-> "0..*" refund_workflow_actions : registra acción >
refund_workflow_instance_levels "0..1" -down-> "0..*" refund_workflow_actions : ocurre en nivel >
refund_workflow_actions "1" -right-> "0..*" refund_workflow_action_images : evidencia firma >
refund_workflow_actions "1" -down-> "0..*" refund_order_detail_decisions : decisión L1 >

' ==============================================================================
' RELACIONES ENTRE MÓDULOS (CORE WORKFLOW PIPELINE)
' ==============================================================================

' --- Territorio y Flota hacia Planificación ---
zones "0..1" -down-> "0..*" dispatch_delivery_points : clasifica por zona >
planning_restrictions "0..1" ..down..> "0..*" planning_trucks : excluye camión por >
trucks "1" -down-> "0..*" planning_trucks : selecciona para plan >

' --- Planificación hacia Ruteo ---
dispatch_plans "1" -down-> "0..*" routes : genera rutas >
dispatch_delivery_points "1" -down-> "0..*" route_delivery_points : optimizado en >
planning_trucks "0..1" -down-> "0..*" routes : asigna a ruta >

' --- Ruteo y Planificación hacia Ejecución de Transporte ---
dispatch_plans "0..1" -down-> "0..*" transport_orders : emite viaje >
routes "0..1" -down-> "0..*" transport_orders : ejecuta plan de ruta >
trucks "0..1" -down-> "0..*" transport_orders : camión físico >
trucks "1" -down-> "0..*" truck_inventories : stock físico a bordo >
logistic_assets "1" -down-> "0..*" transport_order_assets : inventario de activo >

' --- Transporte hacia Última Milla ---
transport_orders "1" -down-> "1..*" delivery_orders : ejecuta paradas >
dispatch_delivery_points "1" -down-> "0..*" delivery_orders : parada programada >

' --- Transporte hacia Liquidación & Cierres (1 a 1 estricto) ---
transport_orders "1" -down-> "0..1" transport_order_warehouse_closings : liquidación almacén >
transport_orders "1" -down-> "0..1" transport_order_collection_closings : liquidación financiera >

' --- Devoluciones con Planificación de Despacho (Flujo Inverso) ---
refund_orders "0..1" ..down..> "0..*" candidate_orders : orden de reposición

' --- Devoluciones con Motor de Workflow ---
refund_orders "1" -right-> "0..*" refund_workflow_instances : somete a aprobación >
refund_orders "0..1" -down-> "0..*" refund_workflow_actions : orden disociada generada >
refund_approval_levels "0..1" ..right..> "0..*" refund_workflow_instance_levels : instancia matriz
refund_order_details "1" -down-> "0..*" refund_order_detail_decisions : ítem decidido L1 >

@enduml
