@startuml

hide circle
top to bottom direction

skinparam linetype polyline
skinparam nodesep 65
skinparam ranksep 75

skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #34495E
    FontSize 11
    FontName "Segoe UI", Arial, sans-serif
}

skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
    FontSize 10
}

skinparam package {
    BorderColor #7F8C8D
    FontColor #1A5276
    FontStyle bold
    FontSize 13
}

title DIAGRAMA DE CLASES DE BASE DE DATOS - ARQUITECTURA MODULAR BACKEND\n(Flujo Desacoplado & Alta Legibilidad)

' ==============================================================================
' 01. REFERENCIAS & INTEGRACIONES EXTERNAS (CORE EXTERNAL DATA)
' ==============================================================================
package "01. Referencias & Integraciones (External Data)" #FDEDEC {
    entity "distributors_ref" as distributors_ref <<SAP / Ventas>> {
        * id : BIGINT <<PK>>
        --
        id_ref : BIGINT
        name : VARCHAR(50)
        latitude : NUMERIC(9,6)
        longitude : NUMERIC(9,6)
        city_id : BIGINT
        code_sap : BIGINT
        is_active : BOOLEAN
    }

    entity "products_ref" as products_ref <<SAP / Catálogo>> {
        * id : BIGINT <<PK>>
        --
        id_ref : BIGINT
        name : VARCHAR(255)
        sku : VARCHAR(255)
        quantity_min : DECIMAL(12,2)
        equivalence_box_unit : DECIMAL(12,2)
    }

    entity "sale_orders_ref" as sale_orders_ref <<SAP / Pedidos Comerciales>> {
        * id : BIGINT <<PK>>
        --
        id_ref : BIGINT
        document_id : BIGINT
        sale_order_split_id : BIGINT
        distributor_id : BIGINT
        total_weight_kg : DECIMAL(12,2)
        total_volume_m3 : DECIMAL(12,2)
        invoice_id : BIGINT
        invoice_amount : DECIMAL(12,2)
    }

    note bottom of distributors_ref
        <b>Referencias Maestras (SAP/Ventas):</b>
        Estas tablas maestras son referenciadas por ID en
        las entidades operativas (distributor_id, product_id, sale_order_id)
        sin trazar cables diagonales para evitar superposición de líneas.
    end note
}

' ==============================================================================
' 02. TERRITORIO, ZONIFICACIÓN & RESTRICCIONES DE CIRCULACIÓN
' ==============================================================================
package "02. Territorio & Restricciones (Territory & Restrictions)" #F4F6F7 {
    entity "zones" as zones <<PostGIS Reparto>> {
        * id : BIGINT <<PK>>
        --
        name : VARCHAR(50)
        polygon : GEOMETRY(Polygon, 4326)
        city_id : BIGINT
        is_active : BOOLEAN
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "distribution_zones" as distribution_zones <<PostGIS Jurisdicción>> {
        * id : BIGINT <<PK>>
        --
        distributor_id : BIGINT <<FK distributors_ref>>
        polygon : GEOMETRY(Polygon, 4326)
        city_id : VARCHAR(255)
        is_active : BOOLEAN
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "sale_channel_restrictions" as sale_channel_restrictions <<Límites Comerciales>> {
        * id : BIGINT <<PK>>
        --
        distributor_id : BIGINT <<FK distributors_ref>>
        name : VARCHAR(50)
        description : VARCHAR(100)
        sale_channel_id : BIGINT
        cut_off_time : TIME
        -- Auditoría --
        created_by : VARCHAR(50)
        updated_by : VARCHAR(50)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "planning_restrictions" as planning_restrictions <<Límites de Tránsito>> {
        * id : BIGSERIAL <<PK>>
        --
        distributor_id : BIGINT <<FK distributors_ref>>
        name : VARCHAR(50)
        description : VARCHAR(100)
        restriction_type : VARCHAR(30)
        effect : VARCHAR(30)
        severity : VARCHAR(20)
        geometry_geojson : JSONB
        is_active : BOOLEAN
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "planning_restriction_schedules" as planning_restriction_schedules <<Vigencias Horarias>> {
        * id : BIGSERIAL <<PK>>
        --
        planning_restriction_id : BIGINT <<FK>>
        valid_from : DATE
        valid_to : DATE
        day_of_week : SMALLINT
        start_time : TIME
        end_time : TIME
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "planning_restriction_vehicle_rules" as planning_restriction_vehicle_rules <<Reglas Flota / Placa>> {
        * id : BIGSERIAL <<PK>>
        --
        planning_restriction_id : BIGINT <<FK>>
        plate_last_digit : SMALLINT
        min_capacity_weight_kg : DECIMAL(12,2)
        truck_type : VARCHAR(50)
        plate : VARCHAR(20)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 03. GESTIÓN DE FLOTA Y ACTIVOS LOGÍSTICOS
' ==============================================================================
package "03. Gestión de Flota y Activos (Fleet & Assets)" #EBF5FB {
    entity "trucks" as trucks <<Flota Operativa>> {
        * id : BIGSERIAL <<PK>>
        --
        distributor_id : BIGINT <<FK distributors_ref | NULL>>
        code : VARCHAR(100)
        plate : VARCHAR(20)
        capacity_weight_kg : DECIMAL(12,2)
        capacity_volume_m3 : DECIMAL(12,2)
        status : VARCHAR(50)
        truck_type : VARCHAR(50)
        is_refrigerated : BOOLEAN
        is_external : BOOLEAN
        shift_start : TIME
        shift_end : TIME
        break_start : TIME
        break_end : TIME
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "logistic_assets" as logistic_assets <<Activos Reutilizables>> {
        * id : BIGSERIAL <<PK>>
        --
        distributor_id : BIGINT <<FK distributors_ref | NULL>>
        code : VARCHAR(50)
        name : VARCHAR(100)
        asset_type : VARCHAR(50)
        is_serialized : BOOLEAN
        tare_weight_kg : DECIMAL(12,2)
        tare_volume_m3 : DECIMAL(12,2)
        is_active : BOOLEAN
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 04. PLANIFICACIÓN DE DESPACHOS (DISPATCH PLANNING)
' ==============================================================================
package "04. Planificación de Despachos (Dispatch Planning)" #EAF2F8 {
    entity "plan_status" as plan_status <<Estados del Plan>> {
        * id : BIGSERIAL <<PK>>
        --
        name : VARCHAR(50)
        description : VARCHAR(100)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "dispatch_plans" as dispatch_plans <<Plan Diario>> {
        * id : BIGSERIAL <<PK>>
        --
        plan_status_id : BIGINT <<FK>>
        distributor_id : BIGINT <<FK distributors_ref>>
        plan_date : DATE
        planned_order_count : INTEGER
        planned_truck_count : INTEGER
        employee_id : BIGINT
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "planning_trucks" as planning_trucks <<Camiones Asignados al Plan>> {
        * id : BIGSERIAL <<PK>>
        --
        dispatch_plan_id : BIGINT <<FK>>
        truck_id : BIGINT <<FK>>
        assigned_weight_kg : DECIMAL(12,2)
        assigned_volume_m3 : DECIMAL(12,2)
        is_included_in_routing : BOOLEAN
        exclusion_reason : VARCHAR(50)
        excluded_by_restriction_id : BIGINT <<FK | NULL>>
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "dispatch_delivery_points" as dispatch_delivery_points <<Parada Unificada>> {
        * id : BIGSERIAL <<PK>>
        --
        dispatch_plan_id : BIGINT <<FK>>
        sale_channel_id : BIGINT
        delivery_point_id : BIGINT
        zone_id : BIGINT <<FK | NULL>>
        owner_id : BIGINT
        owner_name : VARCHAR(50)
        customer_id : BIGINT
        customer_name : VARCHAR(50)
        phone_number : VARCHAR(20)
        address : VARCHAR(255)
        warehouse_destination_id : BIGINT
        priority : INTEGER
        delivery_window_start : TIME
        delivery_window_end : TIME
        total_weight_kg : DECIMAL(12,2)
        total_volume_m3 : DECIMAL(12,2)
        total_neto : DECIMAL(12,2)
        forced_planning_truck_id : BIGINT <<FK | NULL>>
        observations : TEXT
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "image_delivery_points" as image_delivery_points <<Fachadas / Evidencias>> {
        * id : BIGSERIAL <<PK>>
        --
        dispatch_delivery_point_id : BIGINT <<FK | NULL>>
        path_url : TEXT
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "candidate_orders" as candidate_orders <<Pedidos Candidatos>> {
        * id : BIGSERIAL <<PK>>
        --
        dispatch_delivery_point_id : BIGINT <<FK | NULL>>
        sales_order_id : BIGINT <<FK sale_orders_ref>>
        document_id : BIGINT
        distributor_id : BIGINT <<FK distributors_ref>>
        total_weight_kg : DECIMAL(12,2)
        total_volume_m3 : DECIMAL(12,2)
        type_movement : VARCHAR(50)
        is_included : BOOLEAN
        refund_order_id : BIGINT <<FK | NULL>>
        transfer_id : BIGINT <<NULL>>
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 05. RUTEO & OPTIMIZACIÓN (ROUTING & OPTIMIZATION)
' ==============================================================================
package "05. Ruteo & Optimización (Routing & Optimization)" #E9F7EF {
    entity "routes" as routes <<Rutas Calculadas>> {
        * id : BIGSERIAL <<PK>>
        --
        name : VARCHAR(100)
        planning_truck_id : BIGINT <<FK | NULL>>
        dispatch_plan_id : BIGINT <<FK | NULL>>
        employee_id : BIGINT
        driver_employee_id : BIGINT <<NULL>>
        name_driver_employee : VARCHAR(100)
        helper_employee_id : BIGINT <<NULL>>
        name_helper_employee : VARCHAR(100)
        engine : VARCHAR(100)
        executed_at : TIMESTAMP
        eta_total_distance_m : DECIMAL(12,2)
        eta_total_time_s : DECIMAL(12,2)
        score : DECIMAL(12,2)
        total_cost : DECIMAL(12,2)
        is_selected : BOOLEAN
        encode_polyline : TEXT
        color_hex : VARCHAR(6)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "route_delivery_points" as route_delivery_points <<Secuencia de Visita>> {
        * id : BIGSERIAL <<PK>>
        --
        route_id : BIGINT <<FK>>
        dispatch_delivery_point_id : BIGINT <<FK>>
        sequence : INTEGER
        estimated_distance_m : DECIMAL(12,2)
        estimated_travel_s : DECIMAL(12,2)
        is_active : BOOLEAN
        estimated_total_cost : DECIMAL(12,2)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 06. EJECUCIÓN DE TRANSPORTE & CONTROL DE CARGA (RAMP & TRANSPORT ORDERS)
' ==============================================================================
package "06. Ejecución de Transporte & Rampa (Transport Execution & Ramp)" #FEF9E7 {
    entity "transport_orders" as transport_orders <<Viaje / Orden de Transporte>> {
        * id : BIGSERIAL <<PK>>
        --
        dispatch_plan_id : BIGINT <<FK | NULL>>
        distributor_id : BIGINT <<FK distributors_ref>>
        route_id : BIGINT <<FK | NULL>>
        truck_id : BIGINT <<FK | NULL>>
        driver_employee_id : BIGINT <<NULL>>
        name_driver_employee : VARCHAR(100)
        helper_employee_id : BIGINT <<NULL>>
        name_helper_employee : VARCHAR(100)
        supervisor_employee_id : BIGINT <<NULL>>
        name_supervisor_employee : VARCHAR(100)
        code : BIGINT
        status : VARCHAR(50)
        checked_by : VARCHAR(255)
        departure_date : TIMESTAMP | NULL
        completed_date : TIMESTAMP | NULL
        total_km : DECIMAL(12,2)
        assigned_weight_kg : DECIMAL(12,2)
        assigned_volume_m3 : DECIMAL(12,2)
        total_stops_count : INTEGER
        completed_stops_count : INTEGER
        total_revenue_expected : DECIMAL(12,2)
        total_revenue_collected : DECIMAL(12,2)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "transport_order_histories" as transport_order_histories <<Trazabilidad OT>> {
        * id : BIGSERIAL <<PK>>
        --
        transport_order_id : BIGINT <<FK>>
        status : VARCHAR(50)
        description : VARCHAR(150)
        capture_hour : TIME
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "transport_order_sales" as transport_order_sales <<Ventas Asignadas al Viaje>> {
        * id : BIGSERIAL <<PK>>
        --
        transport_order_id : BIGINT <<FK>>
        sales_order_id : BIGINT <<FK sale_orders_ref>>
        sales_order_split_id : BIGINT
        invoice_id : BIGINT
        invoice_amount : DECIMAL(12,2)
        document_id : BIGINT
        total_weight_kg : DECIMAL(12,2)
        total_volume_m3 : DECIMAL(12,2)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "transport_order_sales_items" as transport_order_sales_items <<Ítems de Venta en Viaje>> {
        * id : BIGSERIAL <<PK>>
        --
        transport_order_sales_id : BIGINT <<FK>>
        product_id : BIGINT <<FK products_ref>>
        quantity_min : DECIMAL(12,2)
        equivalence_box_unit : DECIMAL(12,2)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "truck_inventories" as truck_inventories <<Inventario Consolidado en Camión>> {
        * id : BIGSERIAL <<PK>>
        --
        truck_id : BIGINT <<FK>>
        transport_order_id : BIGINT <<FK>>
        product_id : BIGINT <<FK products_ref>>
        equivalence_box_unit : DECIMAL(12,2)
        expected_qty : DECIMAL(12,2)
        expected_boxes : DECIMAL(12,2)
        loaded_qty : DECIMAL(12,2)
        loaded_boxes : DECIMAL(12,2)
        variance_qty : DECIMAL(12,2)
        damaged_qty : DECIMAL(12,2)
        returned_warehouse_qty : DECIMAL(12,2)
        temperature_celsius : DECIMAL(4,1) | NULL
        status : VARCHAR(50)
        verified_supervisor_id : BIGINT | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "transport_order_count_sessions" as transport_order_count_sessions <<Sesiones de Conteo en Rampa>> {
        * id : BIGSERIAL <<PK>>
        --
        transport_order_id : BIGINT <<FK>>
        session_type : VARCHAR(50)
        review_scope : VARCHAR(20)
        status : VARCHAR(30)
        executor_id : BIGINT
        executor_role : VARCHAR(50)
        duration_minutes : INTEGER | NULL
        signature_svg : TEXT | NULL
        device_metadata : JSONB | NULL
        started_at : TIMESTAMP
        completed_at : TIMESTAMP | NULL
        notes : TEXT
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "transport_order_count_session_items" as transport_order_count_session_items <<Detalle Ítems Contados>> {
        * id : BIGSERIAL <<PK>>
        --
        transport_order_count_session_id : BIGINT <<FK>>
        product_id : BIGINT <<FK products_ref>>
        expected_qty : DECIMAL(12,2)
        counted_qty : DECIMAL(12,2)
        counted_boxes : DECIMAL(12,2)
        counted_loose_units : DECIMAL(12,2)
        variance_qty : DECIMAL(12,2)
        equivalence_box_unit : DECIMAL(12,2) | NULL
        is_damaged : BOOLEAN
        damage_reason_code : VARCHAR(50) | NULL
        item_status : VARCHAR(30)
        observation : TEXT
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "transport_order_assets" as transport_order_assets <<Control Salida/Retorno Activos>> {
        * id : BIGSERIAL <<PK>>
        --
        transport_order_id : BIGINT <<FK>>
        logistic_asset_id : BIGINT <<FK>>
        asset_serial_number : VARCHAR(100) | NULL
        planned_qty : DECIMAL(12,2)
        dispatched_qty : DECIMAL(12,2)
        returned_qty : DECIMAL(12,2) | NULL
        variance_qty : DECIMAL(12,2)
        status : VARCHAR(50)
        discrepancy_reason : VARCHAR(100) | NULL
        customer_custody_id : BIGINT | NULL
        receipt_voucher_code : VARCHAR(100) | NULL
        checked_out_by : VARCHAR(255) | NULL
        checked_out_at : TIMESTAMP | NULL
        checked_in_by : VARCHAR(255) | NULL
        checked_in_at : TIMESTAMP | NULL
        notes : TEXT | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 07. ÚLTIMA MILLA & ENTREGAS (LAST MILE DELIVERY & MOBILE)
' ==============================================================================
package "07. Última Milla & Entregas (Last Mile Delivery)" #E8F8F5 {
    entity "delivery_orders" as delivery_orders <<Parada de Entrega>> {
        * id : BIGSERIAL <<PK>>
        --
        transport_order_id : BIGINT <<FK>>
        dispatch_delivery_point_id : BIGINT <<FK>>
        executed_sequence : INTEGER
        delivery_note_number : VARCHAR(100)
        delivery_result_code : VARCHAR(50)
        status : VARCHAR(50)
        arrival_latitude : DECIMAL(12,6)
        arrival_longitude : DECIMAL(12,6)
        arrived_at : TIMESTAMP
        delivered_at : TIMESTAMP | NULL
        departure_at : TIMESTAMP | NULL
        service_time_seconds : INTEGER | NULL
        travel_time_seconds : INTEGER | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "delivery_order_sales" as delivery_order_sales <<Facturas por Parada>> {
        * id : BIGSERIAL <<PK>>
        --
        delivery_order_id : BIGINT <<FK>>
        sale_order_id : BIGINT <<FK sale_orders_ref>>
        company_code : BIGINT
        invoice_id : BIGINT
        total_invoice : DECIMAL(12,2)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "delivery_payment_references" as delivery_payment_references <<Cobranzas en Calle>> {
        * id : BIGSERIAL <<PK>>
        --
        delivery_order_sale_id : BIGINT <<FK>>
        collection_payment_id : BIGINT
        payment_method : VARCHAR(20)
        reference_number : VARCHAR(100)
        bank_name : VARCHAR(100) | NULL
        authorization_code : VARCHAR(100) | NULL
        amount : DECIMAL(12,2)
        currency : VARCHAR(10)
        status : VARCHAR(30)
        cash_breakdown : JSONB | NULL
        metadata : JSONB | NULL
        notes : VARCHAR(100)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "delivery_order_items" as delivery_order_items <<Productos Descargados>> {
        * id : BIGSERIAL <<PK>>
        --
        delivery_order_sale_id : BIGINT <<FK>>
        product_id : BIGINT <<FK products_ref>>
        planned_qty : DECIMAL(12,2)
        delivered_qty : DECIMAL(12,2)
        returned_qty : DECIMAL(12,2)
        unit_price_snapshot : DECIMAL(12,2)
        rejection_reason_code : VARCHAR(50) | NULL
        item_status : VARCHAR(50)
        notes : TEXT
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "proof_of_deliveries" as proof_of_deliveries <<POD Digital (Firma/Foto/GPS)>> {
        * id : BIGSERIAL <<PK>>
        --
        delivery_order_id : BIGINT <<FK>>
        receiver_name : VARCHAR(255)
        receiver_document : VARCHAR(100)
        receiver_relationship : VARCHAR(100)
        signature_url : TEXT | NULL
        image_url : TEXT | NULL
        latitude : DECIMAL(12,6)
        longitude : DECIMAL(12,6)
        status : VARCHAR(50)
        device_id : BIGINT
        captured_at : TIMESTAMP
        uploaded_at : TIMESTAMP | NULL
        notes : TEXT
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "delivery_incidents" as delivery_incidents <<Incidencias en Ruta>> {
        * id : BIGSERIAL <<PK>>
        --
        delivery_order_id : BIGINT <<FK>>
        product_id : BIGINT <<FK products_ref | NULL>>
        incident_code : VARCHAR(50)
        severity : VARCHAR(50)
        description : TEXT
        image_url : TEXT | NULL
        requires_return : BOOLEAN
        resolution_status : VARCHAR(50)
        resolved_at : TIMESTAMP | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "delivery_order_histories" as delivery_order_histories <<Trazabilidad de Parada>> {
        * id : BIGSERIAL <<PK>>
        --
        delivery_order_id : BIGINT <<FK>>
        status : VARCHAR(100)
        reason : TEXT
        captured_at : TIMESTAMP
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 08. LIQUIDACIÓN & CIERRES DE RUTA (SETTLEMENT & CLOSINGS)
