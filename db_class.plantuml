        status : VARCHAR(20)
        current_workflow_instance_id : BIGINT <<FK | NULL>>
        distributor_id : BIGINT <<FK distributors_ref>>
        employee_id : BIGINT
        owner_id : BIGINT
        customer_id : BIGINT
        replacement_date : DATE | NULL
        justification : TEXT
        total : DECIMAL(12,2)
        -- Auditoría --
