        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_order_details" as refund_order_details <<Línea de Devolución>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_order_id : BIGINT <<FK>>
        source_detail_id : BIGINT <<FK | NULL>>
        refund_reason_id : BIGINT <<FK>>
        product_id : BIGINT <<FK products_ref>>
        source_quantity : DECIMAL(12,2)
        quantity : DECIMAL(12,2)
        price_unit : DECIMAL(12,2)
        line_status : VARCHAR(20)
        notes : TEXT | NULL
