        --
        name : VARCHAR(150)
        description : VARCHAR(300) | NULL
        cost_center : VARCHAR(50)
        process_type : VARCHAR(20)
        lot_requirement : VARCHAR(20)
        due_date_requirement : VARCHAR(20)
        requires_photo : BOOLEAN
        requires_notes : BOOLEAN
        sort_order : SMALLINT
        is_active : BOOLEAN
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_reason_params" as refund_reason_params <<Parámetros y Vigencia>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_reason_id : BIGINT <<FK>>
        process_type : VARCHAR(20)
        cost_center : VARCHAR(50) | NULL
        start_date : DATE
        end_date : DATE
        status : VARCHAR(20)
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }

    entity "refund_reason_param_clients" as refund_reason_param_clients <<Alcance: Clientes>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_reason_param_id : BIGINT <<FK>>
        customer_id : BIGINT
        created_at : TIMESTAMP
    }

    entity "refund_reason_param_products" as refund_reason_param_products <<Alcance: SKUs>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_reason_param_id : BIGINT <<FK>>
        product_id : BIGINT <<FK products_ref>>
        created_at : TIMESTAMP
    }

    entity "refund_reason_param_lots" as refund_reason_param_lots <<Alcance: Lotes>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_reason_param_id : BIGINT <<FK>>
        lot_type : VARCHAR(10)
        lot_number : VARCHAR(20)
        created_at : TIMESTAMP
    }

    entity "refund_reason_param_product_groups" as refund_reason_param_product_groups <<Alcance: Categoría/Marca>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_reason_param_id : BIGINT <<FK>>
        group_type : VARCHAR(20)
        group_value : VARCHAR(150)
        created_at : TIMESTAMP
    }

    entity "refund_reason_param_sale_channels" as refund_reason_param_sale_channels <<Alcance: Canales>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_reason_param_id : BIGINT <<FK>>
        sale_channel_id : BIGINT
        created_at : TIMESTAMP
    }

    entity "refund_reason_param_distributors" as refund_reason_param_distributors <<Alcance: Agencias>> {
        * id : BIGSERIAL <<PK>>
        --
        refund_reason_param_id : BIGINT <<FK>>
        distributor_id : BIGINT <<FK distributors_ref>>
        created_at : TIMESTAMP
    }

    entity "refund_approval_levels" as refund_approval_levels <<Matriz de Aprobación>> {
        * id : BIGSERIAL <<PK>>
        --
        workflow_version_id : BIGINT
        level_order : SMALLINT
        name : VARCHAR(100)
        role_code : VARCHAR(50)
        min_amount : DECIMAL(12,2)
        max_amount : DECIMAL(12,2)
        approval_policy : VARCHAR(20)
        required_approvals : SMALLINT
        on_reject : VARCHAR(30)
        is_active : BOOLEAN
        -- Auditoría --
