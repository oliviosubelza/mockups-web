        closing_date : TIMESTAMP
        status : VARCHAR(50)
        total_invoiced_amount : DECIMAL(12,2)
        total_bonus_amount : DECIMAL(12,2)
        total_delivered_amount : DECIMAL(12,2)
        total_returned_amount : DECIMAL(12,2)
        total_dispatch_amount : DECIMAL(12,2)
        cash_amount : DECIMAL(12,2)
        transfer_amount : DECIMAL(12,2)
        qr_amount : DECIMAL(12,2)
        check_amount : DECIMAL(12,2)
        driver_collected_amount : DECIMAL(12,2)
        credit_amount : DECIMAL(12,2)
        collector_amount : DECIMAL(12,2)
        total_to_render : DECIMAL(12,2)
        total_orders_dispatched : INTEGER
        total_orders_invoiced : INTEGER
        total_orders_returned : INTEGER
