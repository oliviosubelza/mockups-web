        driver_signature_svg : TEXT | NULL
        supervisor_signature_svg : TEXT | NULL
        cashier_signature_svg : TEXT | NULL
        admin_signature_svg : TEXT | NULL
        -- Auditoría --
        created_by : VARCHAR(255)
        updated_by : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
        deleted_at : TIMESTAMP | NULL
    }
}

' ==============================================================================
' 09. GESTIÓN DE DEVOLUCIONES (REFUNDS MANAGEMENT)
' ==============================================================================
package "09. Gestión de Devoluciones (Refunds Management)" #FCE4D6 {
    entity "refund_reasons" as refund_reasons <<Motivos de Devolución>> {
        * id : BIGSERIAL <<PK>>
