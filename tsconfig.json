{
  "exclude": ["vite.config.ts", "src/**/__tests__/**/*", "diagrams/**/*"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@keel/platform": ["./packages/platform/src/index.ts"],
      "@keel/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"]
    },
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true
  }
}
