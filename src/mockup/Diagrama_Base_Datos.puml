@startuml

hide circle

skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #34495E
}
skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
}

title DB_LOGISTICS

package "(Snapshots, Cache, Datos externos)" #FDEDEC {
    entity "sales_order" as ext_sales <<MS Ventas - SAP>> {
        * id : <<PK>>
        --
        Ordenes lista para despachar
    }

    entity "sales_order_item" as ext_sales_item <<MS Ventas - SAP>> {
        * id : <<PK>>
        --
        sales_order_split_id : <<FK>>
        product_id : String
        requested_qty : Decimal
        confirmed_qty : Decimal
    }

    ext_sales "1" -- "1..*" ext_sales_item : tiene >

    entity "product_snapshot" as snap_product <<SAP - Cache Local>> {
        * product_id : String
        --
        weight : Decimal
        volume : Decimal
    }

    entity "delivery_point" as snap_delivery_point <<SAP - Cache Local>> {
        * delivery_point_id : String
        --
        customer_id : String
        latitude : Decimal
        longitude : Decimal
        contact_name : String
        contact_phone : String
        address_text : String
    }

    entity "truck" as truck_master <<SAP - Flota de Camiones>> {
        * truck_id : <<PK>>plan
        --
        plate : String
        capacity_weight : Decimal
        capacity_volume : Decimal
        status : String
        truck_type : String
        last_maintenance_at : Timestamp
        created_at : Timestamp
        updated_at : Timestamp
    }

    entity "warehouse_snapshot" as snap_warehouse <<SAP - Almacen>> {
        * warehouse_id : String
        --
        zone_id : String
        status : String
        last_sync_at : Timestamp
    }
}

package "Proyecciones" #F8F9F9 {
    entity "candidate_order" as candidate_order {
        * id : <<PK>>
        --
        dispatch_plan_order_id : <<FK>>
        sales_order_id : String
        customer_id : String
        delivery_point_id : String
        warehouse_id : String
        delivery_window : String
        total_weight : Decimal
        total_volume : Decimal
        priority : Integer
        ready_for_dispatch : Boolean
        status : String
        notes : Text
        created_at : Timestamp
        updated_at : Timestamp
    }
}

package "Despachos (Draft -> Approved)" #EAF2F8 {
    entity "plan_type" as planType {
        * id : <<PK>>
        --
        name: String
        description: String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | null
    }

    entity "plan_status" as planStatus {
        * id : <<PK>>
        --
        name: String
        description: String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | null
    }

    entity "dispatch_plan" as plan {
        * id : <<PK>>
        --
        plan_type_id : <<FK>>
        plan_status_id : <<FK>>
        warehouse_id : String
        plan_date : Date
        plan_type : String
        plan_status : String
        optimization_status : String
        planned_order_count : Integer
        planned_truck_count : Integer
        notes : Text
        created_by : String
        created_at : Timestamp
        updated_at : Timestamp
    }

    entity "planning_truck" as truck {
        * id : <<PK>>
        --
        dispatch_plan_id : <<FK>>
        truck_id : String
        route_id : String
        ' <<driver_employee_id : String>>
        ' <<helper_employee_id : String>>
        -capacity_weight : Decimal
        -capacity_volume : Decimal
        assigned_weight : Decimal
        assigned_volume : Decimal
        status : String <<DISPONIBLE, MANTENIMIENTO>>
        created_at : Timestamp
        updated_at : Timestamp
        -shift_start : Timestamp<<inicio turno>>
        -shift_end : Timestamp<<fin turno>>
        -break_start : Timestamp<<inicio descanso>>
        -break_end : Timestamp<<fin descanso>>
        -is_included_in_routing: boolean <<si el camion 
        esta incluida en una ruta>>
    }

    entity "dispatch_plan_order" as plan_order {
        * id : <<PK>>
        --
        dispatch_plan_id : <<FK>>
        delivery_point_id : String <<Ref_Ruteo>>
        planned_sequence : Integer
        priority : Integer
        delivery_window_override : String
        notes : Text
        created_at : Timestamp
        updated_at : Timestamp
        <<UNIFICACION DE PUNTOS DE ENTREGAS>>
        -forced_planning_truck_id: <<FK | NULL>>
        '
    }
}

package "Rutas y Asignación" #E9F7EF {
    entity "routes" as opt_run {
        * id : <<PK>>
        --
        dispatch_plan_id : <<FK>>
        engine : String
        executed_at : Timestamp
        status : String
        total_distance_km : Decimal
        total_time_min : Decimal
        score : Decimal
        notes : Text
        - total_cost: Decimal
        - is_selected: boolean<<default false>>
        'CABECERA DE LA RUTA, SUMATORIA TOTAL DE LOS METROS, SEGUNDOS Y COSTOS
    }

    entity "route_delivery_points" as opt_order {
        * id : <<PK>>
        --
        route_id : <<FK>>
        dispatch_plan_order_id : <<FK>>
        planning_truck_id : <<FK>>
        sequence : Integer
        eta : Timestamp
        estimated_distance_m : Decimal<<meters>>
        estimated_travel_s : Decimal<<seconds>>
        checked_by : String
        - is_active: Boolean 
        'CUANDO SE UNIFIQUE EN UN SOLO CAMION, SE INVALIDA LAS RUTAS CALCULADAS DE LOS DOS CAMIONES INVOLUCRADOS (is_active:FALSE) Y LOS NUEVOS DATOS DE GOOGLE SE GUARDAN COMO TRUE
        - estimated_total_cost: Decimal<<routeTotalCost>>
        - encode_polyline: String
    }
}

package "Carga en Camion" #FEF9E7 {
    entity "dispatch_order" as exec_order {
        * id : <<PK>>
        --
        dispatch_plan_id : <<FK>>
        truck_id : String
        route_id : String
        warehouse_id : String
        - driver_employee_id : String
        - helper_employee_id : String
        - created_by : String
        status : String (PENDING, LOADING, DISPATCHED)
        departure_date : Timestamp
        created_at : Timestamp
        updated_at : Timestamp
    }

    entity "dispatch_checking" as checking {
        * id : <<PK>>
        --
        dispatch_order_id : <<FK>>
        warehouse_id : String
        checked_by : String
        status : String (IN_PROGRESS, COMPLETED)
        notes : Text
        created_at : Timestamp
        updated_at : Timestamp
    }

    entity "dispatch_checking_item" as checking_item {
        * id : <<PK>>
        --
        dispatch_checking_id : <<FK>>
        product_id : String
        expected_qty : Decimal
        checked_qty : Decimal
        variance_qty : Decimal
        status : String
    }

    entity "truck_inventory" as inventory {
        * id : <<PK>>
        --
        truck_id : String
        dispatch_order_id : <<FK>>
        product_id : String
        loaded_qty : Decimal
        remaining_qty : Decimal
        status : String
        as_of_at : Timestamp
    }
}

package "Ultima Milla (Entregas)" #E8F8F5 {
    entity "delivery_order" as delivery {
        * id : <<PK>>
        --
        dispatch_order_id : <<FK>>
        dispatch_plan_order_id : <<FK>>
        delivery_point_id : String
        sales_order_id : String
        delivery_window : String
        delivery_note_number : String
        receiver_name : String
        receiver_relationship : String
        delivery_result_code : String
        status : String
        arrival_latitude : Decimal
        arrival_longitude : Decimal
        arrived_at : Timestamp
        delivered_at : Timestamp
        created_at : Timestamp
        updated_at : Timestamp

        ' -service_duration_min:Time<<minutos del servicio?>>
        ' -wait_duration_min:Time<<minutos de espera?>>
    }

    entity "delivery_order_item" as delivery_item {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        product_id : String
        planned_qty : Decimal
        loaded_qty : Decimal
        delivered_qty : Decimal
        returned_qty : Decimal
        short_qty : Decimal
        item_status : String
        notes : Text
    }

    entity "proof_of_delivery" as pod {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        receiver_name : String
        receiver_document : String
        signature_url : String
        photo_url : String
        gps_lat : Decimal
        gps_lon : Decimal
        pod_status : String
        pod_result_code : String
        device_id : String
        captured_at : Timestamp
        uploaded_at : Timestamp
        notes : Text
    }

    entity "delivery_incident" as incident {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        incident_code : String
        incident_type : String
        severity : String
        description : Text
        photo_url : String
        requires_return : Boolean
        resolution_status : String
        created_by : String
        created_at : Timestamp
        resolved_at : Timestamp
    }

     entity "delivery_order_history" as delivery_history {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        status : String (CREATED, ENROUTE, ARRIVED, etc.)
        reason : Text
        created_at : Timestamp
    }
}

note right of checking_item
    **Chequeo:**
    el sistema consulta
    sales_order_item para saber que
    productos se deben cargar.
end note

note right of delivery_history
  **Historial de Estados:**
  Relación de 1 a Muchos. Cada parada 
  registra múltiples cambios de estado 
  (Bitácora) permitiendo ver exactamente a qué 
  hora llegó o por qué se canceló.
end note

' ext_sales ..> candidate_order : "crea"
' snap_product ..> candidate_order : "peso/vol"

planType "1" -- "1..*" plan: contiene >
planStatus "1" -- "1..*" plan: tiene >
plan "1" -- "0..*" truck : asigna >
plan "1" -- "1..*" plan_order : contiene paradas >
plan_order "1" -- "0..*" candidate_order : "agrega" >

snap_warehouse ..> plan : "valida almacén"
snap_delivery_point ..> plan_order : "provee GPS"
truck_master "1" .. "0..*" truck : "copia capacidad" >

plan "1" -- "0..*" opt_run : ejecuta >
opt_run "1" -- "0..*" opt_order : resultados >
plan_order "1" .. "0..*" opt_order : "optimizado en" >
truck "1" .. "0..*" opt_order : transportada por >

plan "1" -- "0..*" exec_order : genera >
exec_order "1" -- "0..1" checking : requiere >
checking "1" -- "1..*" checking_item : valida >
exec_order "1" -- "0..*" inventory : establece stock >
ext_sales_item ..> checking_item : "detalle"

exec_order "1" -- "1..*" delivery : "tiene múltiples paradas" >

note right of delivery
    **Viaje vs. Paradas:**
    'dispatch_order' es el camión lleno
    saliendo del almacén. 'delivery_order'
    son las 5, 10 o 20 paradas
    individuales que el camión hará.
end note

note right
    **Prioridad:**
    agregar la prioridad 
    en delivery_order? 
    o viene desde
    sales_order.
end note

note right of plan
    **Planificacion:**
    Despues de que el usuario 
    dibuja en el mapa.
end note

note right
    **Pedidos:**
    se puede  filtrar por vendedor,
    canal y fecha de entrega
end note

note right
    **Camiones:**
    filtrar por volumen, capacidad.
    Se puede llenar por 2 razones, 50 pedidos 
    o limite de capacidad
end note

delivery "1" -- "1..*" delivery_item : "descarga productos" >
delivery "1" -- "0..1" pod : "genera comprobante" >
delivery "1" -- "0..*" incident : "reporta problemas" >
delivery "1" -- "0..*" delivery_history : "registra historial" >

snap_delivery_point ..> delivery : "Provee dirección\ny teléfono"
inventory ..> delivery_item : "Descuenta stock\nal entregar"

@enduml