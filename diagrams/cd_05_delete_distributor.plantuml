@startuml
skinparam lifelineStrategy solid
autonumber
title Diagrama CD 5: DELETE /api/v1/distributors/:id (Baja Lógica de Centro y Zona)

actor "Planificador" as User
participant "App Web" as Web
participant "Gateway Controller" as Gateway
participant "Distributor Service" as Service
participant "Transaction DB\n(QueryRunner)" as TX
participant "distributors DB" as DistDB
participant "distribution_zones DB" as ZoneDB

User -> Web: Confirma "Dar de baja centro de distribución"
Web -> Gateway: DELETE /api/v1/distributors/501
Gateway -> Service: deleteDistributor(id, executorId)

Service -> DistDB: findActiveById(id)
DistDB --> Service: distributorRecord (o null)

alt Centro no encontrado
    Service --> Gateway: 404 Not Found (Centro no encontrado)
    Gateway --> Web: 404 Not Found
    Web --> User: Muestra error en pantalla
else Centro existe
    Service -> TX: startTransaction()
    activate TX

    Service -> DistDB: softDeleteDistributor(id, executorId)
    DistDB --> Service: ok

    Service -> ZoneDB: softDeleteAssociatedZone(distributorId, executorId)
    ZoneDB --> Service: ok

    Service -> TX: commitTransaction()
    deactivate TX

    Service --> Gateway: 200 OK (Centro y zona dados de baja)
    Gateway --> Web: 200 OK
    Web --> User: Remueve depósito y polígono del mapa; retorna al listado
end
@enduml
