        <mxCell id="p27-34" value="27.4 — candidate_orders es el puente y nada más:&lt;br&gt;guarda el sales_order_id y ninguna línea." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1330" y="300" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p27-35" value="27.5 — sales_order_item es de MS Ventas/SAP (DB.puml:24-31).&lt;br&gt;NO existe en UltimaVersion.sql: no es tabla nuestra,&lt;br&gt;es un contrato de servicio que hay que pedir." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1650" y="405" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p27-36" value="27.6 — HUECO: product_snapshot hoy solo tiene&lt;br&gt;weight y volume (DB.puml:35-40). Sin description ni unit&lt;br&gt;no se puede escribir “Aceite girasol 900 ml · cajas”.&lt;br&gt;Hay que ampliar el snapshot o pedirlo en 27.5." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="2010" y="530" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p27-37" value="27.7 — confirmed_qty ≥ requested_qty → CONFIRMED&lt;br&gt;0 &amp;lt; confirmed_qty &amp;lt; requested_qty → PARTIAL&lt;br&gt;confirmed_qty = 0 → NO_STOCK" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1150" y="700" width="350" height="85" as="geometry" />
        </mxCell>
      </root>
