<mxfile host="Electron" pages="20">
  <diagram id="8vrvfHbVP1NwTku8rOth" name="OBTENER CAMIONES Y CANALES (1)">
    <mxGraphModel dx="2355" dy="1111" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\r\n    autonumber\r\n\r\n    actor Dispatcher as Despachador\r\n    participant UI as Frontend\r\n    participant API as Dispatch API\r\n    participant Projection as delivery_candidate_order_projection\r\n    participant DeliveryPoint as delivery_point\r\n    participant TruckMaster as truck_master\r\n    participant Warehouse as warehouse_snapshot\r\n    participant Plan as dispatch_plan\r\n    participant PlanningTruck as planning_truck\r\n    participant PlanOrder as dispatch_plan_order\r\n\r\n    Dispatcher-&gt;&gt;UI: Abrir módulo de planificación\r\n\r\n    UI-&gt;&gt;API: GET /planning\r\n\r\n    par Obtener pedidos\r\n        API-&gt;&gt;Projection: Consultar pedidos proyectados\r\n        Projection--&gt;&gt;API: candidate_orders\r\n    and Obtener puntos de entrega\r\n        API-&gt;&gt;DeliveryPoint: Consultar delivery_points\r\n        DeliveryPoint--&gt;&gt;API: Dirección, GPS, contacto\r\n    and Obtener flota\r\n        API-&gt;&gt;TruckMaster: Consultar camiones disponibles\r\n        TruckMaster--&gt;&gt;API: Camiones\r\n    and Obtener almacén\r\n        API-&gt;&gt;Warehouse: Obtener warehouse\r\n        Warehouse--&gt;&gt;API: Datos del almacén\r\n    end\r\n\r\n    API--&gt;&gt;UI: Pedidos + Delivery Points + Camiones + Warehouse\r\n\r\n    Note over UI: El Frontend une cada candidate_order&lt;br/&gt;con su delivery_point\r\n\r\n    Note over Dispatcher,UI: El usuario visualiza los puntos en el mapa,&lt;br/&gt;consolida pedidos por destino,&lt;br/&gt;asigna camiones y prioridades.\r\n\r\n    Dispatcher-&gt;&gt;UI: Guardar Plan\r\n\r\n    UI-&gt;&gt;API: POST /dispatch-plan\r\n\r\n    activate API\r\n\r\n    API-&gt;&gt;Plan: INSERT dispatch_plan\r\n    Plan--&gt;&gt;API: dispatch_plan_id\r\n\r\n    loop Por cada camión\r\n        API-&gt;&gt;PlanningTruck: INSERT planning_truck\r\n    end\r\n\r\n    loop Por cada parada (delivery_point)\r\n        API-&gt;&gt;PlanOrder: INSERT dispatch_plan_order\r\n        Note right of PlanOrder: Guarda únicamente&lt;br/&gt;delivery_point_id\r\n\r\n        loop Pedidos de esa parada\r\n            API-&gt;&gt;Projection: Asociar candidate_order&lt;br/&gt;al dispatch_plan_order\r\n        end\r\n    end\r\n\r\n    deactivate API\r\n\r\n    API--&gt;&gt;UI: Plan creado (DRAFT)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="68">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="1634" width="2720" as="geometry" />
          </mxCell>
        </UserObject>
