        <mxCell id="p28-29" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=6;" value="28.1 — polygonGeojson viaja en el MISMO formato que la&lt;br&gt;columna polygon_geojson (JSONB): anillo en [lng, lat],&lt;br&gt;cerrado. Leaflet trabaja en [lat, lng]; la conversión&lt;br&gt;es del Frontend y no cruza el endpoint." vertex="1">
          <mxGeometry height="130" width="350" x="1620" y="150" as="geometry" />
        </mxCell>
        <mxCell id="p28-30" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=6;" value="28.4 — polygon_geojson es JSONB, no geometry:&lt;br&gt;la base NO valida nada. Anillo abierto, 3 posiciones o&lt;br&gt;un polígono en moño pasan el INSERT y rompen recién&lt;br&gt;en el 29.5. La validación es obligatoria acá." vertex="1">
          <mxGeometry height="120" width="350" x="1620" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p28-31" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=13;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=6;" value="28.5a — el solapamiento es AVISO, no error:&lt;br&gt;bloquearlo haría imposible corregir un borde compartido.&lt;br&gt;El 29.5a define el desempate en lectura.&lt;br&gt;Hueco: no hay UNIQUE (city_id, name) ni tabla cities,&lt;br&gt;así que city_id no tiene FK." vertex="1">
          <mxGeometry height="130" width="350" x="1620" y="620" as="geometry" />
        </mxCell>
      </root>
